# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.6-flash

# Optional: enables the USDA FoodData Central fallback for foods with no
# verified local record. Get a free key at https://fdc.nal.usda.gov/api-key-signup
# Without it the bot still runs; those foods are reported as unavailable.
USDA_API_KEY=

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
